        <mxCell id="preflight" value="04  Check readiness&#10;Validate all three files and prompt hashes&#10;Show per-metric evidence availability&#10;Explain missing / inapplicable inputs&#10;No report saved by this check" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7e8;strokeColor=#d7ae62;fontColor=#78521d;fontFamily=Helvetica;fontSize=15.705931495405181;align=center;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="44" y="630" width="400" height="146" as="geometry" />
        </mxCell>
        <mxCell id="run" value="05  Run evaluation&#10;Revalidate the current input files&#10;Score each declared case/system/trial&#10;Aggregate cases; show coverage&#10;Save only the derived report" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf3ff;strokeColor=#365cbd;fontColor=#163566;fontFamily=Helvetica;fontSize=17.828354670459934;align=center;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1">
