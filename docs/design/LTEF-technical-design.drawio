        </mxCell>
        <mxCell id="inspect" value="06  Inspect evidence&#10;Read scope + denominators + warnings&#10;Check failures alongside quality means&#10;Export report and retain source inputs&#10;Publish only claims supported by evidence" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#edf8f3;strokeColor=#6a9c84;fontColor=#21533a;fontFamily=Helvetica;fontSize=16.08900299529311;align=center;verticalAlign=middle;spacing=12;arcSize=8;" vertex="1" parent="1">
